# Epidemic Lab — Simulation Configuration (TEMPLATE)
# Copy to .env and fill in values. NEVER commit .env.

# Topology profile
# legacy   -> agent-c -> agent-b -> agent-a
# epidemic -> courier-1/courier-2 -> analyst-1/analyst-2 -> guardian
EPIDEMIC_TOPOLOGY=epidemic

# LLM Models (Ollama tags)
AGENT_A_MODEL=llama3.2:latest
AGENT_B_MODEL=dolphin-mistral:latest
AGENT_C_MODEL=dolphin-mistral:latest
AGENT_C_ATTACK_MODEL=dolphin-mistral:latest

# LLM Global Settings
LLM_ENABLED=1
# Raise above observed steady-state latency to avoid forced fallback.
LLM_TIMEOUT_S=180

# Agent A (Guardian) — High Security
AGENT_A_DEFENSE_LEVEL=0.85
GUARDIAN_MAX_INFECTION_P=0.15
GUARDIAN_HARD_BLOCK_CONFIDENCE=0.60
GUARDIAN_SUSPICION_WINDOW=5
GUARDIAN_SUSPICION_THRESHOLD=3
GUARDIAN_IMMUNITY_BOOST_ON_BLOCK=0.04
AGENT_A_LLM_TEMPERATURE=0.2

# Agent B (Analyst) — Medium Security
AGENT_B_DEFENSE_LEVEL=0.50
LLM_COMPLIANCE_WEIGHT=0.25
ANALYST_MAX_DEFENSE_REDUCTION=0.25
ANALYST_MAX_DEFENSE_BOOST=0.20
ANALYST_MIN_INFECTION_P=0.15
ANALYST_MAX_INFECTION_P=0.85
ANALYST_GRAY_ZONE_LOW=0.30
ANALYST_GRAY_ZONE_HIGH=0.70
AGENT_B_LLM_TEMPERATURE=0.35

# Agent C (Courier) — Attacker
USE_LLM_PAYLOADS=1
LLM_ATTACK_BOOST=1.15
AGENT_C_LLM_TEMPERATURE=0.7
ATTACKER_OBJECTIVE=SPREAD_FAST
ATTACKER_LOCK_OBJECTIVE=0
# Planner RNG defaults
ATTACKER_SEED=1337
# ATTACKER_SEED_COURIER_1=1337
# ATTACKER_SEED_COURIER_2=1338
ATTACKER_DEBUG=0
ATTACK_GENERATION_MAX_RETRIES=3

# Timing
HEARTBEAT_INTERVAL_S=3600

# C2 post-compromise containment
C2_BEACON_BLOCK_PROB=0.35
C2_TASK_BLOCK_PROB=0.30
C2_EXFIL_BLOCK_PROB=0.45
C2_SESSION_TTL_S=300
C2_MAX_BEACONS_PER_SESSION=8

# LLM verdict cache
LLM_VERDICT_CACHE_TTL_S=300

# External C2 beacon server (optional)
C2_BEACON_SERVER_URL=
# Vercel Deployment Protection bypass — Vercel Dashboard → Settings → Deployment Protection
VERCEL_PROTECTION_BYPASS=
VERCEL_AUTOMATION_BYPASS_SECRET=
C2_BEACON_FORWARD_ENABLED=0
